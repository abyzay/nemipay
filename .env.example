# ==============================================================================
# NemiPay - Variables de Entorno de Ejemplo
# ==============================================================================
# Copia este archivo como `.env` para desarrollo local.
# IMPORTANTE DE SEGURIDAD:
# - NUNCA coloques secretos privados (service_role, PEY_API_KEY, PEY_WEBHOOK_SECRET,
#   CRON_SECRET) en variables con prefijo `EXPO_PUBLIC_`. Todo valor con ese
#   prefijo queda incrustado en el bundle del cliente.
# - Nunca subas archivos `.env` reales al repositorio.
# ==============================================================================

# Ambiente activo de la aplicación: development | production
EXPO_PUBLIC_APP_ENV=development

# Proyecto Supabase (público: URL + llave anon/publishable)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Tiempo máximo de espera por petición HTTP en milisegundos
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Tope máximo permitido por cobro en centavos ($99,999.00 MXN = 9999900)
EXPO_PUBLIC_MAX_CHARGE_CENTS=9999900

# ==============================================================================
# Variables EXCLUSIVAS para scripts locales (scripts/seed-demo.ts)
# NO usar prefijo EXPO_PUBLIC_ aquí.
# ==============================================================================
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# DEMO_EMAIL=demo@nemipay.mx
# DEMO_PASSWORD=<demo-password>
# DEMO_MERCHANT_NAME=Mi Negocio Demo

{
  "expo": {
    "name": "NemiPay",
    "slug": "nemipay",
    "scheme": "nemipay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nemipay.app"
    },
    "android": {
      "package": "com.nemipay.app",
      "adaptiveIcon": {
        "backgroundColor": "#087F5B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF8"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que NemiPay utilice Face ID para proteger el acceso a tu negocio."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#087F5B"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que NemiPay utilice la cámara para tomar fotos de tus productos.",
          "photosPermission": "Permitir que NemiPay acceda a tus fotos para asignar imágenes a tus productos.",
          "microphonePermission": false
        }
      ],
      "@react-native-vector-icons/ionicons"
    ]
  }
}
